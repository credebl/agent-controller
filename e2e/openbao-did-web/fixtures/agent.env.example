# Environment for the live did:web + OpenBao integration suite. Source it before starting the agents:
#   set -a; . e2e/openbao-did-web/fixtures/agent.env.example; set +a
OPENBAO_ENABLED=true
OPENBAO_WRITE_ENABLED=true
OPENBAO_ADDRESS=http://127.0.0.1:8201
OPENBAO_TOKEN=root-dev-token
OPENBAO_HEALTH_CHECK=true
OPENBAO_DID_WEB_ENABLED=true
OPENBAO_DID_KEY_ENABLED=true
OPENBAO_DEPLOYMENT_ID=openbao-did-web-integration
API_KEY=local-integration-api-key-16
PURGE_ENABLED=false
